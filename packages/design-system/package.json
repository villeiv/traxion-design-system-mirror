{
  "name": "@traxion-global/design-system",
  "version": "0.0.15",
  "description": "Traxion Design System",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./tailwind-preset": "./dist/tailwind-preset.cjs",
    "./theme.css": "./dist/theme.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "dist/theme.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts && node scripts/copy-extras.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "exit 0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/traxion-global/design-system.git"
  },
  "author": "Traxion Global",
  "license": "UNLICENSED",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.0.2",
    "eslint": "^9.0.0",
    "tsup": "^8.5.1"
  }
}
